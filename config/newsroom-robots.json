{
  "version": 8,
  "owner": "NAS Editor-in-Chief",
  "principles": [
    "NAS Editor-in-Chief is the sole scheduler and recovery authority",
    "GitHub robots execute bounded jobs and never schedule peer robots",
    "source collectors, translators, F3, Pages and auditor are verified stage-by-stage",
    "publication writers are serialized to prevent lost updates",
    "each stage is bound to a source version before primary-to-alternate escalation",
    "GREEN requires deployed production verification and fresh NAS attestation",
    "workflow success is never trusted without post-run data verification",
    "absolute freshness gates prevent upstream+downstream stale equality from being marked healthy",
    "final Core recovery remains local and independent of rate-limited hosted translation APIs",
    "Discord publication is a final NAS-assigned delivery stage, not an independent scheduler"
  ],
  "stages": [
    {
      "id": "content-core",
      "primaryRobot": "core-translator",
      "workflow": "sync-japanese-news.yml",
      "writes": [
        "data/latest.json",
        "data/live.json",
        "data/translation-cache.json"
      ],
      "fallbackRobot": "core-alternate-recovery",
      "fallbackMode": "bounded alternate job inside sync-japanese-news.yml after normal and emergency outcomes fail",
      "recoveryPolicy": {
        "primary": "local OPUS-MT with 429 circuit breaker",
        "firstFallback": "single emergency remote rebuild",
        "alternate": "independent local M2M100 direct → zh-en-ja pivot → clause retry",
        "retryPolicy": "verify each outcome; do not repeat hosted recovery loops after emergency failure",
        "google429CircuitBreakerSeconds": 90,
        "publishRequiresNonDegraded": true,
        "verifyOutcomeBeforeAccepting": true
      },
      "alternateRobot": "core-secondary-local-recovery",
      "alternateWorkflow": "sync-japanese-news.yml",
      "alternatePolicy": {
        "backend": "facebook/m2m100_418M on GitHub Actions CPU",
        "license": "MIT",
        "sourceLanguage": "zh after local Traditional-to-Simplified normalization",
        "targetLanguage": "ja",
        "independentFrom": [
          "Google/GTX",
          "MyMemory",
          "primary OPUS-MT"
        ],
        "scope": "rejected source-linked fields only",
        "publishRequires": "source parity + non-degraded + content integrity + editorial quality + furigana + vocab validation",
        "decodeStrategy": "direct zh→ja; if rejected, local zh→en→ja pivot; then clause-local retry; never relax quality gates"
      }
    },
    {
      "id": "source-stocks",
      "primaryRobot": "source-stock-primary",
      "repository": "kanuli/daily-brief-newspaper",
      "workflow": "stock-publication-maintenance.yml",
      "primaryInput": {
        "recovery_mode": "normal"
      },
      "fallbackRobot": "source-stock-deep",
      "fallbackInput": {
        "recovery_mode": "deep"
      },
      "freshness": "upstream stocks-latest timestamp must be no older than 8 hours",
      "recoveryPolicy": {
        "verifyOutcomeBeforeAccepting": true,
        "alternateAfterNoImprovementForSameSourceVersion": true
      }
    },
    {
      "id": "content-rolling",
      "primaryRobot": "rolling-translator",
      "workflow": "repair-extra-translation-quality.yml",
      "fallbackRobot": "rolling-exhaustive-recovery",
      "fallbackWorkflow": "repair-all-published-quality.yml",
      "writes": [
        "data/desk-latest.json",
        "data/stocks-latest.json",
        "data/topic-more/**",
        "data/translation-cache.json"
      ],
      "recoveryPolicy": {
        "rejectDegradedBeforePublish": true,
        "verifyOutcomeBeforeAccepting": true,
        "boundedExhaustiveRetries": 3
      }
    },
    {
      "id": "source-vocab",
      "primaryRobot": "source-vocab-generator",
      "repository": "kanuli/daily-brief-newspaper",
      "workflow": "daily-japanese-vocab.yml",
      "freshness": "upstream data/vocab/latest.json date must equal current HKT date",
      "selfHealing": true
    },
    {
      "id": "vocab",
      "primaryRobot": "vocab-translator",
      "workflow": "sync-daily-vocab.yml",
      "freshness": "latest.date must equal current HKT date and data/vocab/YYYY-MM-DD.json must exist",
      "selfHealing": true,
      "writes": [
        "data/vocab/latest.json",
        "data/vocab/YYYY-MM-DD.json"
      ],
      "fallbackRobot": "vocab-exhaustive-recovery",
      "fallbackWorkflow": "recover-daily-vocab.yml",
      "recoveryPolicy": {
        "verifyOutcomeBeforeAccepting": true,
        "primary": "sync-daily-vocab.yml with bounded retries",
        "fallback": "recover-daily-vocab.yml with longer bounded backoff",
        "acceptance": "latest.date == today HKT and dated archive exists and matches latest"
      },
      "supervisedBy": "NAS Editor-in-Chief"
    },
    {
      "id": "f3",
      "primaryRobot": "f3-voice",
      "workflow": "rebuild-f3-pacing.yml",
      "dependsOn": [
        "content-core",
        "content-rolling"
      ],
      "writes": [
        "data/** audio metadata",
        "audio/**"
      ]
    },
    {
      "id": "pages",
      "primaryRobot": "pages-publisher",
      "workflow": "pages.yml",
      "dependsOn": [
        "f3"
      ],
      "writes": [
        "GitHub Pages deployment"
      ]
    },
    {
      "id": "delivery-attestation",
      "primaryRobot": "delivery-auditor",
      "workflow": "editor-in-chief-newsroom-robot.yml",
      "dependsOn": [
        "pages"
      ],
      "writes": [
        "data/newsroom-health.json"
      ],
      "role": "audit-only",
      "dispatchesPeerRobots": false
    },
    {
      "id": "discord-delivery",
      "primaryRobot": "discord-publisher",
      "workflow": "discord-after-pages.yml",
      "dependsOn": [
        "delivery-attestation"
      ],
      "role": "external-delivery",
      "deliveryPolicy": {
        "onePerHktLivePublicationHour": true,
        "pagesMustMatchMain": true,
        "maxAttemptsPerSourceVersion": 2,
        "successRequiredBeforeNasGreen": true
      }
    }
  ],
  "state": {
    "defaultPath": "/volume2/docker/editor-in-chief/state/japanese-newsroom-control-plane.json",
    "version": 3,
    "statuses": [
      "assigned",
      "waiting",
      "verified"
    ],
    "sourceVersionBound": true
  },
  "policies": {
    "stockAbsoluteFreshnessHours": 8,
    "vocabCurrentHktDateRequired": true,
    "vocabDatedArchiveRequired": true,
    "detailedFaultReasons": true,
    "workflowOutcomeVerification": true,
    "vocabOutcomeAlternateRecovery": true,
    "sourceVersionBoundEscalation": true,
    "nasIsSoleScheduler": true,
    "githubAuditorDispatchesPeerRobots": false,
    "greenOnlyAfterFreshAuditorAttestation": true,
    "discordOwnedByNasEditor": true,
    "discordIndependentScheduleDisabled": true,
    "discordWorkflowRunTriggerDisabled": true,
    "discordMaxAttemptsPerSourceVersion": 2
  }
}
